# Shared API authentication. Replace with a long random value.
API_TOKEN=replace-this-with-a-long-random-secret
API_BASE_URL=http://127.0.0.1:8000

# Discord bot. Leave blank until the bot is configured.
DISCORD_TOKEN=
# Optional: use a test server ID for quicker slash-command sync.
DISCORD_GUILD_ID=

# Local storage and browser dashboard origins.
VRCL_DATA_DIR=./data
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Agent identity. Leave blank to use the Windows computer's hostname.
AGENT_ID=
HEARTBEAT_INTERVAL_SECONDS=30
