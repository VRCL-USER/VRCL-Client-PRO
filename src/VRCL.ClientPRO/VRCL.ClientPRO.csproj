<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VRCL PRO</AssemblyName>
    <RootNamespace>VRCL.ClientPRO</RootNamespace>
    <ApplicationIcon>Assets\vrcl-pro.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <InformationalVersion>v1.1.01</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\vrcl-pro.ico" />
  </ItemGroup>
</Project>
