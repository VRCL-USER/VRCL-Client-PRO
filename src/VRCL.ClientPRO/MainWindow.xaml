 <Window x:Class="VRCL.ClientPRO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRCL Client PRO v1.0.03" Width="1120" Height="760" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="VRCL Client PRO" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Your local VRChat desktop companion" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="LOCAL APP" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
            </Border>
        </Grid>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,18,4,4">
                        <TextBlock Text="Welcome back." FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock Text="Manage instance links and contributor-authorized avatar files from one place." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20"/>
                        <UniformGrid Columns="2" Rows="2">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="INSTANCE JOINING" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Open official VRChat links" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Paste a VRChat instance link and hand it to the installed client." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,10">
                                <StackPanel><TextBlock Text="AUTHORIZED LIBRARY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Creator-supplied .vrca files" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Keep each imported file together with its signed permission record." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="LOCAL STORAGE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Stored on this PC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="No Discord bot, cloud API, or account password storage." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel><TextBlock Text="AUDIT TRAIL" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Consent + SHA-256" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Imported files are hashed and linked to the supplied consent document." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="#241A35" BorderBrush="#654A88" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,18,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="#E6D9FA">This first desktop build uses creator-supplied files and official VRChat instance links. It does not scrape live instances or bypass VRChat access controls.</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Join Instances">
                <Grid Margin="12,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Join an instance" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="Paste an official VRChat instance or invite link. VRCL Client PRO opens it through your normal browser/client handoff; your existing VRChat sign-in remains in control." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12" MaxWidth="850"/>
                    <StackPanel Grid.Row="2"><Label Content="VRChat instance link"/><TextBox x:Name="InstanceLinkTextBox" Height="40" VerticalContentAlignment="Center" ToolTip="Paste a link copied from VRChat"/><Button Content="Open instance link" Width="180" HorizontalAlignment="Left" Click="JoinInstance_Click"/></StackPanel>
                    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,24,0,0" VerticalAlignment="Top">
                        <StackPanel><TextBlock Text="Supported workflow" FontWeight="SemiBold"/><TextBlock Text="Instance discovery and membership checks remain in VRChat's official experience. This page is a convenient launcher for links you are allowed to use." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Authorized Asset Import">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Import contributor asset" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="The creator supplies the .vrca file and their signed permission document. Both are stored locally with an audit record." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,16"/>
                            <Label Content="Asset display name"/><TextBox x:Name="AssetNameTextBox"/>
                            <Label Content="Contributor / creator name"/><TextBox x:Name="ContributorNameTextBox"/>
                            <Label Content="Contributor VRChat User ID (optional)"/><TextBox x:Name="ContributorUserIdTextBox"/>
                            <Label Content="Avatar ID (optional)"/><TextBox x:Name="AvatarIdTextBox"/>
                            <Label Content="Permission scope (describe what the creator approved)"/><TextBox x:Name="PermissionScopeTextBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Local import, storage, inspection, and conversion of this supplied file."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Files and confirmation" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,12"/>
                            <Label Content="Creator-supplied .vrca file"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AssetFileTextBox" IsReadOnly="True" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Margin="8,4,0,10" Click="BrowseAsset_Click"/></Grid>
                            <Label Content="Signed permission document"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ConsentFileTextBox" IsReadOnly="True" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="Browse" Margin="8,4,0,10" Click="BrowseConsent_Click"/></Grid>
                            <CheckBox x:Name="PermissionConfirmedCheckBox" Foreground="{StaticResource TextBrush}" Margin="0,12,0,16">
                                <TextBlock Text="I confirm the creator supplied this file or explicitly authorized its transfer, and the attached document records that permission." TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                            </CheckBox>
                            <Button x:Name="ImportButton" Content="Import authorized asset" Height="42" Click="ImportAsset_Click"/>
                            <TextBlock x:Name="ImportStatusTextBlock" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,25,0,0">
                                <StackPanel><TextBlock Text="What this import does" FontWeight="SemiBold"/><TextBlock Text="Copies the selected .vrca and consent file into your local VRCL data folder, calculates a SHA-256 hash, and adds a library record. It does not fetch files from a live VRChat instance." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Library">
                <Grid Margin="12,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Authorized asset library" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Local records with contributor, avatar ID, consent attachment, and file hash." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14"/></StackPanel>
                        <Button Grid.Column="1" Content="Open storage folder" VerticalAlignment="Center" Click="OpenLibraryFolder_Click"/>
                    </Grid>
                    <DataGrid x:Name="AssetsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" RowBackground="#191426" AlternatingRowBackground="#211A30" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Asset" Binding="{Binding AssetName}" Width="1.3*"/>
                            <DataGridTextColumn Header="Contributor" Binding="{Binding ContributorName}" Width="1.1*"/>
                            <DataGridTextColumn Header="VRChat User ID" Binding="{Binding ContributorUserId}" Width="1.4*"/>
                            <DataGridTextColumn Header="Avatar ID" Binding="{Binding AvatarId}" Width="1.4*"/>
                            <DataGridTextColumn Header="Imported (UTC)" Binding="{Binding ImportedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="LibraryCountTextBlock" Grid.Row="2" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="FooterStatusTextBlock" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,14,0,0" Text="Ready · Local-first mode"/>
    </Grid>
</Window>
