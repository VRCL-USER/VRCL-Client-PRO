<Window x:Class="VRCL.ClientPRO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VRCL PRO v1.1.01" Icon="Assets/vrcl-pro.ico"
        Width="1180" Height="800" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/vrcl-pro.ico" Width="62" Height="62" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VRCL PRO" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="VRChat desktop companion · v1.1.01" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="LOCAL APP" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,18,4,4">
                        <TextBlock Text="Welcome to VRCL PRO." FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock Text="A local desktop workspace for VRChat instance links and your local avatar/world asset library." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,20"/>
                        <UniformGrid Columns="2" Rows="2">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="INSTANCE LINKS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Open official VRChat links" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
                                    <TextBlock Text="Hand an instance or invite link to the installed VRChat client using your normal account." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="LOCAL ASSET LIBRARY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Avatar and world files" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
                                    <TextBlock Text="Import files already on your PC and add avatar, user, world, and location IDs." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="LOCAL STORAGE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Stored on this PC" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
                                    <TextBlock Text="No Discord bot, remote API, VRChat password, cookie, or session-token storage." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="COMMAND CONSOLE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="Visible command output" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5"/>
                                    <TextBlock Text="Run local app commands and inspect IDs parsed from text or links you provide." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="#241A35" BorderBrush="#654A88" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,18,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="#E6D9FA">VRCL PRO uses official VRChat link handoff and local files you select. It does not run an automated VRChat bot, scrape live instances, unlock all avatars, or extract protected avatar/world data from the platform.</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Instances">
                <Grid Margin="12,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Open a VRChat instance" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="Paste an official VRChat instance or invite link. VRCL PRO opens it through your normal browser/client handoff; the installed VRChat client and your existing sign-in handle the join." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12" MaxWidth="900"/>
                    <StackPanel Grid.Row="2">
                        <Label Content="VRChat instance or invite link"/>
                        <TextBox x:Name="InstanceLinkTextBox" Height="40" VerticalContentAlignment="Center" ToolTip="Paste a link copied from VRChat"/>
                        <Button Content="Open in VRChat" Width="180" HorizontalAlignment="Left" Click="JoinInstance_Click"/>
                    </StackPanel>
                    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,24,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Instance handoff" FontWeight="SemiBold"/>
                            <TextBlock Text="This launches the link with the standard VRChat client flow. It does not create a separate bot account or automate actions inside an instance." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Instance Journal">
                <Grid Margin="12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Instance journal" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="Save instance details and observations you obtain through the official VRChat client or other permitted sources. This is a local notebook, not a live instance scanner." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <TextBlock Text="Official instance link (optional)" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="JournalInstanceLinkTextBox" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Parse link" Margin="8,4,0,10" Click="ParseJournalLink_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="World name"/><TextBox x:Name="JournalWorldNameTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="World ID"/><TextBox x:Name="JournalWorldIdTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Location / instance ID"/><TextBox x:Name="JournalLocationIdTextBox"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="User IDs (one per line)"/><TextBox x:Name="JournalUserIdsTextBox" Height="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Avatar IDs (one per line)"/><TextBox x:Name="JournalAvatarIdsTextBox" Height="62" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Notes" Margin="0,8,0,3"/>
                        <TextBox x:Name="JournalNotesTextBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <Button Content="Save instance entry" Width="180" HorizontalAlignment="Left" Margin="0,10,0,14" Click="SaveInstanceEntry_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="InstanceJournalDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" RowBackground="#191426" AlternatingRowBackground="#211A30" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="World" Binding="{Binding WorldName}" Width="1.2*"/>
                            <DataGridTextColumn Header="World ID" Binding="{Binding WorldId}" Width="1.2*"/>
                            <DataGridTextColumn Header="Location ID" Binding="{Binding LocationId}" Width="1.2*"/>
                            <DataGridTextColumn Header="Users" Binding="{Binding UserIds}" Width="1.2*"/>
                            <DataGridTextColumn Header="Avatars" Binding="{Binding AvatarIds}" Width="1.2*"/>
                            <DataGridTextColumn Header="Saved UTC" Binding="{Binding SavedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Asset Import">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Import a local asset" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="Select an asset file already on your PC. Contributor details and signed documents are not required for this local import form." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,16"/>
                            <Label Content="Asset type"/>
                            <ComboBox x:Name="AssetTypeComboBox" SelectedIndex="0" Background="#120E1C" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,4,0,10">
                                <ComboBoxItem Content="Avatar"/>
                                <ComboBoxItem Content="World"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                            <Label Content="Display name (optional; defaults to filename)"/>
                            <TextBox x:Name="AssetNameTextBox"/>
                            <Label Content="User ID (optional)"/>
                            <TextBox x:Name="UserIdTextBox"/>
                            <Label Content="Avatar ID (optional)"/>
                            <TextBox x:Name="AvatarIdTextBox"/>
                            <Label Content="World name (optional)"/>
                            <TextBox x:Name="WorldNameTextBox"/>
                            <Label Content="World ID (optional)"/>
                            <TextBox x:Name="WorldIdTextBox"/>
                            <Label Content="Location / instance ID (optional)"/>
                            <TextBox x:Name="LocationIdTextBox"/>
                            <Label Content="Notes (optional)"/>
                            <TextBox x:Name="AssetNotesTextBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="File and preview" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,12"/>
                            <Label Content="Local asset file (.vrca, .vrcw, .unitypackage, .zip)"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="AssetFileTextBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Browse" Margin="8,4,0,10" Click="BrowseAsset_Click"/>
                            </Grid>
                            <Label Content="Preview image (optional)"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ThumbnailFileTextBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Browse" Margin="8,4,0,10" Click="BrowseThumbnail_Click"/>
                            </Grid>
                            <CheckBox x:Name="PermissionConfirmedCheckBox" Foreground="{StaticResource TextBrush}" Margin="0,12,0,16">
                                <TextBlock Text="I own this local file or have permission to inspect and use it." TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                            </CheckBox>
                            <Button x:Name="ImportButton" Content="Import to local library" Height="42" Click="ImportAsset_Click"/>
                            <TextBlock x:Name="ImportStatusTextBlock" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,25,0,0">
                                <StackPanel>
                                    <TextBlock Text="Local import details" FontWeight="SemiBold"/>
                                    <TextBlock Text="The app copies the selected file and optional preview into your local VRCL data folder, calculates a SHA-256 hash, and stores the metadata you entered. It does not download files from VRChat instances." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Library">
                <Grid Margin="12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Local asset library" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="Avatar/world files, manually supplied IDs, optional previews, and SHA-256 hashes." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open selected file" VerticalAlignment="Center" Margin="0,0,8,12" Click="OpenSelectedAsset_Click"/>
                        <Button Grid.Column="2" Content="Open storage folder" VerticalAlignment="Center" Margin="0,0,0,12" Click="OpenLibraryFolder_Click"/>
                    </Grid>
                    <DataGrid x:Name="AssetsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" RowBackground="#191426" AlternatingRowBackground="#211A30" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Preview" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Image Source="{Binding ThumbnailPath}" Width="42" Height="42" Stretch="UniformToFill" Margin="3"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Asset" Binding="{Binding AssetName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding AssetType}" Width="0.7*"/>
                            <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="1.1*"/>
                            <DataGridTextColumn Header="Avatar ID" Binding="{Binding AvatarId}" Width="1.1*"/>
                            <DataGridTextColumn Header="World" Binding="{Binding WorldName}" Width="1.0*"/>
                            <DataGridTextColumn Header="World ID" Binding="{Binding WorldId}" Width="1.1*"/>
                            <DataGridTextColumn Header="Location ID" Binding="{Binding LocationId}" Width="1.1*"/>
                            <DataGridTextColumn Header="Imported UTC" Binding="{Binding ImportedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="LibraryCountTextBlock" Grid.Row="2" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Console">
                <Grid Margin="12,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Command console" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="Local application commands and visible output. Commands do not automate VRChat or scrape platform data." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                    </StackPanel>
                    <TextBox x:Name="ConsoleOutputTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0B0911" Foreground="#D7C8ED" BorderBrush="{StaticResource BorderBrush}" FontFamily="Consolas" FontSize="12" Padding="12"/>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ConsoleCommandTextBox" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Type help for available commands" KeyDown="ConsoleCommand_KeyDown"/>
                        <Button Grid.Column="1" Content="Run command" Width="135" Click="RunConsoleCommand_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="FooterStatusTextBlock" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,14,0,0" Text="Ready · Local-first mode"/>
    </Grid>
</Window>
